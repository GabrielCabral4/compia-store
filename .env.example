# Copie este arquivo para .env antes de rodar o projeto.

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Desenvolvimento (padrão): SQLite, sem instalar nada.
DATABASE_URL="file:./dev.db"

# Produção (ex.: Vercel + Postgres): troque também o `provider` do datasource
# em prisma/schema.prisma para "postgresql".
# DATABASE_URL="postgresql://usuario:senha@host:5432/compia?schema=public"

# ---------------------------------------------------------------------------
# Segurança
# ---------------------------------------------------------------------------
# Assina os cookies de sessão e do carrinho. Gere um valor novo em produção:
#   openssl rand -base64 32
APP_SECRET="compia-dev-secret-troque-em-producao-0000000000"

# URL pública da loja (usada nos links dos e-mails).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# E-mail (opcional)
# ---------------------------------------------------------------------------
# Sem SMTP configurado, as notificações são gravadas no banco e ficam visíveis
# em /admin/emails, e o fluxo continua funcionando normalmente.
# SMTP_HOST="smtp.exemplo.com"
# SMTP_PORT="587"
# SMTP_USER="usuario"
# SMTP_PASS="senha"
# SMTP_FROM="COMPIA Editora <nao-responda@compia.com.br>"
